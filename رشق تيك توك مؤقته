bool isVPN() {
    const char* command = "/sbin/ifconfig";
    FILE* fp = popen(command, "r");
    if (!fp) {
        perror("Failed to execute command");
        return false;
    }

    char line[1024];
    bool vpnDetected = false;
    while (fgets(line, sizeof(line), fp)) {
        if (strstr(line, "tun") || strstr(line, "ppp")) {
            vpnDetected = true;
            break;
        }
    }

    pclose(fp);
    return vpnDetected;
}

